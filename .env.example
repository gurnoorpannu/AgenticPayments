# ---- MandateGuard configuration ----
# MODE selects whether the guard layer is engaged.
#   vulnerable = guard bypassed (naive AP2-style implementation)
#   guarded    = guard engaged (MandateGuard middleware)
MODE=guarded

# ---- Razorpay (TEST MODE ONLY - keys must start with rzp_test_) ----
# Get these from https://dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- LLM (any OpenAI-compatible endpoint) ----
LLM_API_KEY=
# Google Gemini exposes an OpenAI-compatible endpoint:
#   https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
# Fixed seed / temperature 0 keeps attack scenarios reproducible.
LLM_TEMPERATURE=0
LLM_SEED=1337
LLM_TIMEOUT_SECONDS=45

# ---- Storage ----
DB_PATH=mandateguard.db
